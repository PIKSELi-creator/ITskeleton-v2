# ==============================
# ITskeleton configuration
# ==============================

# TikTok Developer
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# OAuth callback
TIKTOK_REDIRECT_URI=https://sandbox-itskeleton-skeleton.mia0.amvera.tech/auth/tiktok/callback

# Public application URL
PUBLIC_BASE_URL=https://sandbox-itskeleton-skeleton.mia0.amvera.tech

# MCP
MCP_API_KEY=

# Encryption key for TikTok tokens
# Используй длинную случайную строку.
TOKEN_ENCRYPTION_KEY=

# CapCut
CAPCUT_MODE=auto

# Optional CapCut proxy
# Оставь пустым, если прокси не нужен.
CAPCUT_PROXY=

# Video storage
VIDEO_OUTPUT_DIR=/data/videos

# General data storage
DATA_DIR=/data